[Unit]
Description=Record darkfid dnet P2P events to local NDJSON history
Documentation=https://www.reymom.xyz/darknode
After=darkfid.service
# PartOf, not Wants: stopping or restarting darkfid carries over to the recorder,
# but the recorder never starts darkfid. With Wants, Restart=always here brought
# darkfid back up minutes after it had been stopped on purpose (21-S).
PartOf=darkfid.service

[Service]
Type=simple
EnvironmentFile=-/etc/darknode-export.env
ExecStart=/usr/local/bin/dnet-record.sh
# darkfid restarts kill the TCP stream — come back, but gently.
Restart=always
RestartSec=15
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Same hardening posture as the exporter; localhost only, writes only
# to its log directory.
LogsDirectory=darknode
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
