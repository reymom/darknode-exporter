# /etc/darknode-export.env  —  install with:  sudo install -m 600 …
# Generate the token ONCE and use the same value in Vercel NODE_INGEST_TOKEN:
#   openssl rand -hex 32

NODE_INGEST_TOKEN=replace-me-with-openssl-rand-hex-32
INGEST_URL=https://your-site.example/api/node-ingest
# The daily history digest reuses both of the above and derives its own
# endpoint (.../api/node-history), so there is nothing else to configure.
# HISTORY_INGEST_URL=  # only if the digest must go somewhere else

# Local xmrig HTTP API (restricted mode, no access token, localhost only)
XMRIG_API=http://127.0.0.1:18088

# systemd unit names
DARKFID_UNIT=darkfid.service
XMRIG_UNIT=xmrig.service

# optional: last N WASM success lines from journald
WASM_TAIL_N=12

# optional: override height/tip scraper with a local command that prints:
#   <height> <tip> <peers> <difficulty>
# DARKFID_HEIGHT_CMD=/usr/local/bin/darkfid-height-tip.sh
