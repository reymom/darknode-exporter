[Unit]
Description=darkscope panel — serve this node's own network on localhost
Documentation=https://github.com/reymom/darkscope
After=network.target

[Service]
Type=simple
# DNET_DIR is where the collector writes; PORT and NODE_NAME are yours to set.
EnvironmentFile=-/etc/darkscope.env
Environment=DNET_DIR=/var/log/darknode
Environment=PORT=8080
ExecStart=/usr/bin/python3 /usr/local/share/darkscope/serve.py
Restart=always
RestartSec=5
Nice=10
# It reads log files and serves them. It has no business doing anything else.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/var/log/darknode
# the peer-pseudonym map is the one thing it writes
ReadWritePaths=/var/log/darknode
MemoryMax=128M

[Install]
WantedBy=multi-user.target
