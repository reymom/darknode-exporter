+/// EXPERIMENT (25-S), not upstream: one engine for the process, and the compiled
+/// modules kept.
+///
+/// The metering middleware instruments the module at compile time and each new
+/// instance gets its own copy of the remaining-points global, initialised to
+/// `GAS_LIMIT` — so a cached module still meters every call from zero. Gas per
+/// block is the check: it has to come out identical to what the logger
+/// recorded, or the cache changed something it must not.
+/// Read once: `std::env::var` allocates, and this sits in the per-call path of
+/// an experiment about allocation.
+static CACHE_ON: OnceLock<bool> = OnceLock::new();
+static CRANELIFT: OnceLock<bool> = OnceLock::new();
+
+/// One (engine, module) per distinct contract, keyed by the contract's wasm
+/// rather than by its id — contracts get redeployed, 31 times in this chain's
+/// history, and the bytes are the identity.
+///
+/// The pair, not the module alone: `Metering` keeps per-module state, so one
+/// middleware cannot compile two modules and therefore one engine cannot serve
+/// two contracts.
+static MODULE_CACHE: OnceLock<Mutex<BTreeMap<Vec<u8>, (wasmer::Engine, Module)>>> =
+    OnceLock::new();
+
+fn new_engine() -> wasmer::Engine {
+    let cost_function = |_operator: &Operator| -> u64 { 1 };
+    let metering = Arc::new(Metering::new(GAS_LIMIT, cost_function));
+    if *CRANELIFT.get_or_init(|| std::env::var("DARKFID_CRANELIFT").is_ok()) {
+        // Slower to compile, faster to run — the right trade only once the
+        // compiled module is kept.
+        let mut compiler_config = Cranelift::new();
+        compiler_config.push_middleware(metering);
+        compiler_config.into()
+    } else {
+        let mut compiler_config = Singlepass::new();
+        compiler_config.push_middleware(metering);
+        compiler_config.into()
+    }
+}
+
+fn engine_and_module(wasm_bytes: &[u8]) -> Result<(wasmer::Engine, Module)> {
+    let compile = || -> Result<(wasmer::Engine, Module)> {
+        let engine = new_engine();
+        let store = Store::new(engine.clone());
+        let module = Module::new(&store, wasm_bytes)?;
+        Ok((engine, module))
+    };
+
+    if !*CACHE_ON.get_or_init(|| std::env::var("DARKFID_MODCACHE").as_deref() != Ok("0")) {
+        return compile();
+    }
+
+    let cache = MODULE_CACHE.get_or_init(|| Mutex::new(BTreeMap::new()));
+    if let Some(pair) = cache.lock().get(wasm_bytes) {
+        return Ok(pair.clone());
+    }
+    let pair = compile()?;
+    cache.lock().insert(wasm_bytes.to_vec(), pair.clone());
+    Ok(pair)
+}
